# ---- Backend ----
# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Comma-separated LiteLLM model names. Key N uses model N (cycling if fewer models than keys).
LLM_MODELS=gemini/gemini-2.5-flash
# SQLite location (docker-compose forces sqlite:////data/app.db on the named volume).
DATABASE_URL=sqlite:///./app.db
# Comma-separated CORS origins, scheme included, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# true enables the X-Simulate-Failure test hook (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
# LiteLLM in-memory response cache.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
# Most recent history messages sent to the model per request (the full history is still stored).
MAX_HISTORY_MESSAGES=20
LLM_TIMEOUT_SECONDS=30

# ---- Frontend (build time) ----
# Backend base URL baked into the frontend bundle by Vite.
VITE_API_BASE_URL=http://localhost:8000

# ---- Optional host port overrides for docker compose ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
